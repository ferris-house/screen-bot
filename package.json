{
  "name": "wechat-auto-sender",
  "version": "2.0.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "chcp 65001 && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w robotjs,node-window-manager",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --config electron-builder.config.yml",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.config.yml",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.config.yml"
  },
  "dependencies": {
    "robotjs": "^0.6.0",
    "node-window-manager": "^2.2.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "@electron/rebuild": "^4.0.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17"
  }
}